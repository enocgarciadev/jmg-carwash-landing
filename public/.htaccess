# Se copia a dist/ en el build y llega al servidor con el deploy (rsync).
# Todo va dentro de <IfModule>: si falta un módulo, Apache ignora el bloque en vez de dar error 500.

# Una sola página: cualquier otra ruta es un 404 real (sin fallback a index.html)
<IfModule mod_dir.c>
  FallbackResource disabled
</IfModule>
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio canónico: https://www.jmgcarwashcorp.com
  RewriteCond %{HTTP_HOST} ^jmgcarwashcorp\.com$ [NC]
  RewriteRule ^ https://www.jmgcarwashcorp.com%{REQUEST_URI} [R=301,L]

  # /index.html duplica la home
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Los archivos de /assets llevan hash en el nombre: se pueden cachear para siempre
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|jpg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
